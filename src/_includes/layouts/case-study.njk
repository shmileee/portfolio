---
layout: layouts/base.njk
---
{% from "partials/case-card.njk" import caseProof %}
{% set adjacentStudies = collections.caseStudies | studyNeighbors(number) %}
<main class="case-detail" id="main-content" tabindex="-1">
  <header class="case-detail-header">
    <a class="back-link" href="/#index">← all case studies</a>
    <p class="section-eyebrow">Case study {{ number | pad2 }}{% if featured %} · featured{% endif %}</p>
    <h1>{{ title }}</h1>
    {% if role and evidence %}
      {{ caseProof(summary, role, evidence, "case-detail-proof") }}
    {% else %}
      <p class="case-detail-summary">{{ summary }}</p>
    {% endif %}
    <div class="topic-list" aria-label="Topics">
      {% for topic in topics %}<span>{{ topic }}</span>{% endfor %}
    </div>
  </header>
  <article class="prose case-detail-prose">{{ content | safe }}</article>
  <nav class="case-detail-adjacent" aria-label="Adjacent case studies">
    <a href="{{ adjacentStudies.previous.url }}" data-study-direction="previous">
      <span class="case-detail-adjacent-kicker">Previous</span>
      <span class="case-detail-adjacent-number">Case {{ adjacentStudies.previous.data.number | pad2 }}</span>
      <span class="case-detail-adjacent-title">{{ adjacentStudies.previous.data.title }}</span>
    </a>
    <a href="{{ adjacentStudies.next.url }}" data-study-direction="next">
      <span class="case-detail-adjacent-kicker">Next</span>
      <span class="case-detail-adjacent-number">Case {{ adjacentStudies.next.data.number | pad2 }}</span>
      <span class="case-detail-adjacent-title">{{ adjacentStudies.next.data.title }}</span>
    </a>
  </nav>
  <nav class="case-detail-footer" aria-label="Portfolio navigation">
    <a href="/#index">View all work →</a>
    <a href="/#contact">Contact</a>
  </nav>
</main>
