<footer class="site-footer" id="contact">
  <div class="footer-inner">
    <div>
      <p class="footer-brand">{{ site.brand }}</p>
      <p class="footer-note">{{ site.disclaimer }}</p>
    </div>
    <div class="contact-links">
      {% for link in site.contactLinks %}
        <a href="{{ link.href }}"{% if link.external %} target="_blank" rel="noreferrer"{% endif %}>
          {{ link.label }}{% if link.external %}<span aria-hidden="true"> ↗</span>{% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</footer>
