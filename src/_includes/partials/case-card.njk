{% macro caseProof(summary, role, evidence, classes = "") %}
  {% if role and evidence %}
    <dl class="case-proof {{ classes }}" data-case-proof>
      <div><dt>Impact</dt><dd>{{ summary }}</dd></div>
      <div><dt>My role</dt><dd>{{ role }}</dd></div>
      <div><dt>Evidence</dt><dd>{{ evidence }}</dd></div>
    </dl>
  {% endif %}
{% endmacro %}

{% macro caseCard(study, index, initialCount) %}
  {% set classes = "case-card" %}
  {% if study.data.featured %}{% set classes = classes + " case-card-featured" %}{% endif %}
  <a
    class="{{ classes }}"
    href="{{ study.url }}"
    data-case-card
    data-open-study="{{ study.data.caseStudyId }}"
    data-topics="{{ study.data.topics | join('|') }}"
    data-initially-hidden="{{ index >= initialCount }}"
  >
    <span class="case-card-number">
      {{ study.data.number | pad2 }}{% if study.data.featured %} · featured{% endif %}{% if study.data.cardLabel %} · {{ study.data.cardLabel }}{% endif %}
    </span>
    <span class="case-card-title">{{ study.data.title }}</span>
    {% if study.data.role and study.data.evidence %}
      {{ caseProof(study.data.summary, study.data.role, study.data.evidence, "case-card-proof") }}
    {% else %}
      <span class="case-card-summary">{{ study.data.summary }}</span>
    {% endif %}
    <span class="case-card-topics">{{ study.data.topics | join(' · ') }}</span>
    <span class="case-card-action">{% if study.data.spotlight %}full story ↑{% else %}read →{% endif %}</span>
  </a>
{% endmacro %}
