<dialog class="reader" id="case-study-reader" aria-labelledby="reader-title" data-reader>
  <div class="reader-shell">
    <div class="reader-toolbar">
      <button class="reader-close" type="button" aria-label="Close case study" data-reader-close>×</button>
    </div>
    <article class="reader-study" data-reader-study>
      <p class="reader-meta">
        <span class="reader-meta-number" data-reader-meta-number></span><span class="reader-meta-topics" data-reader-meta-topics></span>
      </p>
      <h2 class="reader-title" id="reader-title" tabindex="-1" data-reader-title>Case study reader</h2>
      <p class="sr-only" role="status" aria-live="polite" data-reader-status>Choose a case study to read.</p>
      <div class="prose reader-prose" data-reader-prose></div>
      <nav class="reader-navigation" aria-label="Case study navigation">
        <button type="button" data-reader-direction="previous">
          <span data-reader-direction-kicker></span>
          <span data-reader-case-number></span>
          <span data-reader-case-title></span>
        </button>
        <button type="button" data-reader-direction="next">
          <span data-reader-direction-kicker></span>
          <span data-reader-case-number></span>
          <span data-reader-case-title></span>
        </button>
      </nav>
    </article>
  </div>
  <script type="application/json" data-reader-manifest>
    [
      {% for study in collections.caseStudies %}
        {
          "number": {{ study.data.number }},
          "url": {{ study.url | dump | safe }},
          "title": {{ study.data.title | dump | safe }},
          "topics": {{ study.data.topics | dump | safe }}
        }{% if not loop.last %},{% endif %}
      {% endfor %}
    ]
  </script>
</dialog>
